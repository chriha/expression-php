{
    "name": "chriha/expression",
    "description": "A readable regular expression alternative",
    "type": "library",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "pestphp/pest": "^2.35",
        "phpstan/phpstan": "^1.12",
        "squizlabs/php_codesniffer": "^3.10",
        "laravel/pint": "^1.17",
        "symfony/var-dumper": "^7.1",
        "rector/rector": "^1.2"
    },
    "license": "MIT",
    "keywords": ["regex", "regular-expression", "fluent", "php", "builder"],
    "autoload": {
        "psr-4": {
            "Chriha\\Expression\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Christopher Hartmann",
            "email": "chriha@me.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
